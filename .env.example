# Server
PORT=3000

# SQLite
DB_PATH=./data/products.db

# WAHA
WAHA_URL=https://your-waha-instance.example.com
WAHA_SESSION=default
WAHA_API_KEY=
WEBHOOK_SECRET=replace-with-a-long-random-secret

# Odoo (sync only — never used by the bot at query time)
ODOO_URL=https://your-odoo-instance.example.com
ODOO_DB=your-odoo-database
ODOO_USER=your-odoo-user@example.com
ODOO_PASSWORD=

# Bot config
# Trigger word: users must start their message with this word
# Change to * or any prefix you prefer
BOT_TRIGGER=stock
ADVISOR_PHONE=+54 9 11 5221-4436
